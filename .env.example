# ==========================================
# CẤU HÌNH MÔI TRƯỜNG HỆ THỐNG QLPH (PRODUCTION)
# ==========================================

# Cổng khởi chạy Server Express (Render / Railway tự động cấu hình biến PORT)
PORT=3001

# Chuỗi bí mật mã hóa JWT Token (Bắt buộc đổi sang chuỗi ngẫu nhiên bảo mật cao)
JWT_SECRET=seee_hust_jwt_secret_production_2026_xyz

# Domain Frontend được phép gọi API (Bỏ trống hoặc đặt URL Vercel của bạn)
# Ví dụ: FRONTEND_URL=https://qlph-hust.vercel.app
FRONTEND_URL=

# URL API của Backend dành cho Frontend Vite (nếu deploy tách biệt Frontend trên Vercel)
# Ví dụ: VITE_API_URL=https://qlph-server.onrender.com/api
# Nếu deploy gộp 1 dịch vụ duy nhất trên Render thì để trống.
VITE_API_URL=

# (Tùy chọn) Chuỗi kết nối PostgreSQL Cloud (Supabase hoặc Neon.tech)
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=
